<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest of the Microsoft Store package. packaging/store/windows/make-msix.ps1 fills in the {{…}} placeholders:
  the identity (Name, Publisher and PublisherDisplayName) is the one Partner Center shows under
  Product management > Product identity, and the Store re-signs the package with that publisher.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 uap10 rescap">

  <Identity Name="{{IDENTITY_NAME}}" Publisher="{{PUBLISHER}}" Version="{{VERSION}}" ProcessorArchitecture="{{ARCHITECTURE}}" />

  <Properties>
    <DisplayName>Valafind</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <!--
    The UI languages (Valafind.App/Localization, Loc.Languages), English first: the Store lists them as the languages
    the app supports, and the Store listing import (packaging/store/listing) names its language columns after them.
  -->
  <Resources>
    <Resource Language="en-us" />
    <Resource Language="zh-Hans" />
    <Resource Language="hi" />
    <Resource Language="es" />
    <Resource Language="ar" />
    <Resource Language="fr" />
    <Resource Language="bn" />
    <Resource Language="pt-BR" />
    <Resource Language="ru" />
    <Resource Language="id" />
    <Resource Language="ur" />
    <Resource Language="de" />
    <Resource Language="ja" />
    <Resource Language="mr" />
    <Resource Language="vi" />
    <Resource Language="te" />
    <Resource Language="ha-Latn" />
    <Resource Language="tr" />
    <Resource Language="ta" />
    <Resource Language="ko" />
    <Resource Language="da" />
  </Resources>

  <Applications>
    <!-- A regular desktop program (full trust), started from the executable that dotnet publish produced. -->
    <Application Id="Valafind" Executable="Valafind.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Valafind"
        Description="Find files by meaning, entirely on this computer."
        BackgroundColor="transparent"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Images\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!--
          Start at login. A packaged app cannot use the HKCU Run key (its registry writes stay inside the package), so
          Windows starts it from this task instead; users switch it in Settings > Apps > Startup or Task Manager.
        -->
        <uap5:Extension Category="windows.startupTask" Executable="Valafind.exe" EntryPoint="Windows.FullTrustApplication" uap10:Parameters="--background">
          <uap5:StartupTask TaskId="ValafindStartup" Enabled="true" DisplayName="Valafind" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
