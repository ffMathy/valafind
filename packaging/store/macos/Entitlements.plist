<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements of the Mac App Store build. make-pkg.sh fills in __TEAM_ID__ and __BUNDLE_ID__; they must match the
  provisioning profile. The Mac App Store requires the App Sandbox, which limits Valafind to the folders the user picks
  in an open panel; app-scope bookmarks keep that access across restarts.
-->
<plist version="1.0">
<dict>
  <key>com.apple.application-identifier</key>
  <string>__TEAM_ID__.__BUNDLE_ID__</string>
  <key>com.apple.developer.team-identifier</key>
  <string>__TEAM_ID__</string>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-only</key>
  <true/>
  <key>com.apple.security.files.bookmarks.app-scope</key>
  <true/>
</dict>
</plist>
