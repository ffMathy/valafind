<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Valafind.App</RootNamespace>
    <AssemblyName>Valafind</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\valafind.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <!-- A true single file: native libraries (ONNX Runtime, Skia, HarfBuzz, SQLite, ANGLE) go into the bundle too and
         are unpacked by the .NET host on first start. No bundle compression: it would have to inflate the ~310 MB
         model into memory on every start. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup Condition="'$(ValafindModelDir)' == ''">
    <!-- Builds without a bundled model (ValafindModelDir unset, see src/Valafind.Model) need a one-time download.
         The model download scripts ship next to the executable (<app>/tools/…), so the "model not installed"
         screen can show a command with an absolute path that works in the installed layout. Kept out of the
         single-file bundle on purpose: the user runs them directly. -->
    <Content Include="..\..\tools\fetch-model.sh" Link="tools\fetch-model.sh">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="..\..\tools\fetch-model.ps1" Link="tools\fetch-model.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Valafind.Core\Valafind.Core.csproj" />
    <ProjectReference Include="..\Valafind.Model\Valafind.Model.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Valafind.App.Tests" />
  </ItemGroup>
</Project>
