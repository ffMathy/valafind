<!-- Styles and themes shared by the three launcher designs. Colours come from each view's own palette (Vf* brushes). -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <!-- Platform UI fonts with the embedded Inter as fallback (mockups fall back to Inter too). -->
    <FontFamily x:Key="VfFontWindows">Segoe UI Variable Text, Segoe UI, fonts:Inter#Inter</FontFamily>
    <FontFamily x:Key="VfFontMac">SF Pro Text, .AppleSystemUIFont, Helvetica Neue, fonts:Inter#Inter</FontFamily>
    <FontFamily x:Key="VfFontLinux">Cantarell, Adwaita Sans, Noto Sans, fonts:Inter#Inter</FontFamily>

    <!--
      Minimal button: background/border/corner come from the Button itself; hover and press add a translucent overlay
      (VfHoverOverlayBrush / VfPressOverlayBrush from the enclosing palette).
    -->
    <ControlTheme x:Key="VfButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource VfTextBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <ContentPresenter Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <Border Name="PART_Overlay" IsHitTestVisible="False" CornerRadius="{TemplateBinding CornerRadius}"
                    Background="{DynamicResource VfHoverOverlayBrush}" Opacity="0" />
          </Panel>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ Border#PART_Overlay">
        <Setter Property="Opacity" Value="1" />
      </Style>
      <Style Selector="^:pressed /template/ Border#PART_Overlay">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Background" Value="{DynamicResource VfPressOverlayBrush}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.5" />
      </Style>
    </ControlTheme>
  </Styles.Resources>

  <Style Selector="Button.vf">
    <Setter Property="Theme" Value="{StaticResource VfButton}" />
  </Style>

  <!-- Chrome-less text box used for the search fields. -->
  <Style Selector="TextBox.bare">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource VfTextBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource VfAccentBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource VfSelectionBrush}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource VfTextBrush}" />
    <Setter Property="PlaceholderForeground" Value="{DynamicResource VfPlaceholderBrush}" />
  </Style>
  <Style Selector="TextBox.bare /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.bare:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="TextBox.bare:focus">
    <Setter Property="Foreground" Value="{DynamicResource VfTextBrush}" />
  </Style>
  <Style Selector="TextBox.bare:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource VfTextBrush}" />
  </Style>

  <!-- Numbers line up in score columns and counters. -->
  <Style Selector="TextBlock.num">
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>

  <!-- Rows react to the pointer. -->
  <Style Selector="Border.row">
    <Setter Property="Cursor" Value="Hand" />
    <!-- Transparent (not null) so the whole row is hit-testable; views override for hover/selected. -->
    <Setter Property="Background" Value="Transparent" />
  </Style>
</Styles>
