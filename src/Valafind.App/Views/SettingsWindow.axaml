<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Valafind.App.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Valafind.App.ViewModels"
        xmlns:c="using:Valafind.App.Controls"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="720"
        x:Class="Valafind.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{x:Static l:Strings.SettingsTitle}"
        Width="580" Height="720" MinWidth="480" MinHeight="480"
        WindowStartupLocation="CenterScreen">
  <Design.DataContext>
    <x:Static Member="vm:DesignData.Settings" />
  </Design.DataContext>

  <Window.Styles>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,8,0,2" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="16,12" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Padding="20,12" BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Content="{x:Static l:Strings.Cancel}" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="88" />
          <Button Content="{x:Static l:Strings.Save}" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="88" Classes="accent" />
        </StackPanel>
        <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                   VerticalAlignment="Center" Margin="0,0,12,0" />
      </DockPanel>
    </Border>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="20,16,20,20" Spacing="10">
        <!-- Hotkey -->
        <TextBlock Classes="section" Text="{x:Static l:Strings.SettingsGlobalShortcut}" />
        <Border Classes="card">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <c:HotkeyBox Text="{Binding Hotkey}" PlaceholderText="{x:Static l:Strings.SettingsHotkeyPlaceholder}"
                           AutomationProperties.Name="{x:Static l:Strings.SettingsGlobalShortcut}" />
              <Button Grid.Column="1" Content="{x:Static l:Strings.SettingsReset}" Command="{Binding ResetHotkeyCommand}" />
            </Grid>
            <TextBlock Classes="hint" Text="{Binding DefaultHotkeyText}" />
            <TextBlock Text="{Binding HotkeyMessage}" IsVisible="{Binding HotkeyMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" FontSize="12" />
          </StackPanel>
        </Border>

        <!-- Folders -->
        <TextBlock Classes="section" Text="{x:Static l:Strings.SettingsIndexedFolders}" />
        <Border Classes="card">
          <StackPanel Spacing="8">
            <!-- Empty state: the home folder is what gets indexed. -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,2" IsVisible="{Binding HasNoRoots}">
              <c:StrokeIcon Data="{StaticResource VfIconFolder}" Width="16" Height="16" StrokeThickness="1.8"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding RootsEmptyText}" VerticalAlignment="Center"
                         TextTrimming="PathSegmentEllipsis" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Roots}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,2">
                    <c:StrokeIcon Data="{StaticResource VfIconFolder}" Width="16" Height="16" StrokeThickness="1.8"
                                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center" TextTrimming="PathSegmentEllipsis" />
                    <Button Grid.Column="2" Content="{x:Static l:Strings.SettingsRemove}"
                            Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveRootCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="{x:Static l:Strings.SettingsAddFolder}" Command="{Binding AddRootCommand}" HorizontalAlignment="Left" />
            <TextBlock Classes="hint" Text="{Binding RootsHint}" />
          </StackPanel>
        </Border>

        <!-- Resources -->
        <TextBlock Classes="section" Text="{x:Static l:Strings.SettingsIdleSection}" />
        <Border Classes="card">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="160,*,48" ColumnSpacing="12">
              <TextBlock TextWrapping="Wrap" Text="{x:Static l:Strings.SettingsMaxCpu}" VerticalAlignment="Center" />
              <Slider Grid.Column="1" Minimum="5" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                      Value="{Binding MaxCpuPercent}" AutomationProperties.Name="{x:Static l:Strings.SettingsMaxCpuA11y}" />
              <TextBlock Grid.Column="2" Text="{Binding MaxCpuText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
            <Grid ColumnDefinitions="160,*,48" ColumnSpacing="12">
              <TextBlock TextWrapping="Wrap" Text="{x:Static l:Strings.SettingsMaxDisk}" VerticalAlignment="Center" />
              <Slider Grid.Column="1" Minimum="5" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                      Value="{Binding MaxDiskBusyPercent}" AutomationProperties.Name="{x:Static l:Strings.SettingsMaxDiskA11y}" />
              <TextBlock Grid.Column="2" Text="{Binding MaxDiskText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
            <CheckBox Content="{x:Static l:Strings.SettingsPauseOnBattery}" IsChecked="{Binding PauseOnBattery}" />
          </StackPanel>
        </Border>

        <!-- Model -->
        <TextBlock Classes="section" Text="{x:Static l:Strings.SettingsModelSection}" />
        <Border Classes="card">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
              <TextBlock TextWrapping="Wrap" Text="{x:Static l:Strings.SettingsDimensions}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding DimensionOptions}" SelectedItem="{Binding SelectedDimensions}"
                        MinWidth="120" AutomationProperties.Name="{x:Static l:Strings.SettingsDimensionsA11y}" />
            </Grid>
            <TextBlock Classes="hint" Text="{x:Static l:Strings.SettingsDimensionsHint}" />
            <Border Background="{DynamicResource SystemFillColorCautionBackgroundBrush}" CornerRadius="4" Padding="10,6"
                    IsVisible="{Binding ShowReindexWarning}">
              <TextBlock Text="{x:Static l:Strings.SettingsReindexWarning}" TextWrapping="Wrap" FontSize="12" />
            </Border>
            <Grid ColumnDefinitions="160,*,Auto" ColumnSpacing="12">
              <TextBlock TextWrapping="Wrap" Text="{x:Static l:Strings.SettingsModelFolder}" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Text="{Binding ModelDirectory}" PlaceholderText="{x:Static l:Strings.SettingsModelFolderAutomatic}"
                       AutomationProperties.Name="{x:Static l:Strings.SettingsModelFolder}" />
              <Button Grid.Column="2" Content="{x:Static l:Strings.SettingsBrowse}" Command="{Binding BrowseModelDirectoryCommand}" />
            </Grid>
            <TextBlock Classes="hint" Text="{Binding ModelDetectionText}" />
            <TextBlock Classes="hint" Text="{x:Static l:Strings.SettingsPrivacy}" />
          </StackPanel>
        </Border>

        <!-- General -->
        <TextBlock Classes="section" Text="{x:Static l:Strings.SettingsGeneral}" />
        <Border Classes="card">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="160,*" ColumnSpacing="12">
              <TextBlock TextWrapping="Wrap" Text="{x:Static l:Strings.SettingsLanguage}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}"
                        MinWidth="200" AutomationProperties.Name="{x:Static l:Strings.SettingsLanguage}" />
            </Grid>
            <TextBlock Classes="hint" Text="{x:Static l:Strings.SettingsLanguageHint}" IsVisible="{Binding ShowLanguageRestartHint}" />
            <CheckBox Content="{x:Static l:Strings.SettingsStartAtLogin}" IsChecked="{Binding StartAtLogin}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="2">
                <CheckBox Content="{x:Static l:Strings.SettingsAutoUpdate}" IsChecked="{Binding AutomaticUpdates}" />
                <TextBlock Classes="hint" Text="{Binding UpdateStatus}" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" VerticalAlignment="Top" Content="{x:Static l:Strings.SettingsCheckForUpdates}" Command="{Binding CheckForUpdatesCommand}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock Classes="hint" VerticalAlignment="Center" TextTrimming="PathSegmentEllipsis" TextWrapping="NoWrap">
                <Run Text="{x:Static l:Strings.SettingsLogs}" /><Run Text=" " /><Run Text="{Binding LogDirectory}" />
              </TextBlock>
              <Button Grid.Column="1" Content="{x:Static l:Strings.SettingsOpenLogFolder}" Command="{Binding OpenLogFolderCommand}" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
