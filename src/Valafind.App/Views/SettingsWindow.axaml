<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:Valafind.App.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Valafind.App.ViewModels"
        xmlns:c="using:Valafind.App.Controls"
        mc:Ignorable="d" d:DesignWidth="580" d:DesignHeight="720"
        x:Class="Valafind.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{x:Static l:Strings.SettingsTitle}"
        Width="580" Height="720" MinWidth="480" MinHeight="480"
        WindowStartupLocation="CenterScreen">
  <Design.DataContext>
    <x:Static Member="vm:DesignData.Settings" />
  </Design.DataContext>

  <!--
    Layout: a tinted page with one white card per section. Every setting is a row inside its card: what it is (title and
    hint) on the leading side, the control on the trailing side, rows separated by hairlines. Cards are translucent so a
    Windows Mica backdrop (see SettingsWindow.AttachBackdrop) still shows through.
  -->
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="VfSettingsPageBrush" Color="#F3F3F5" />
          <SolidColorBrush x:Key="VfSettingsAccentBrush" Color="{DynamicResource SystemAccentColorDark1}" />
          <SolidColorBrush x:Key="VfSettingsCardBrush" Color="#E6FFFFFF" />
          <SolidColorBrush x:Key="VfSettingsCardBorderBrush" Color="#14000000" />
          <SolidColorBrush x:Key="VfSettingsDividerBrush" Color="#0F000000" />
          <SolidColorBrush x:Key="VfSettingsSubtleBrush" Color="#5F5F66" />
          <SolidColorBrush x:Key="VfSettingsIconChipBrush" Color="#140067C0" />
          <SolidColorBrush x:Key="VfSettingsWarningBackgroundBrush" Color="#FFF4CE" />
          <SolidColorBrush x:Key="VfSettingsWarningBrush" Color="#8A4B00" />
          <SolidColorBrush x:Key="VfSettingsFooterBrush" Color="#F9F9FB" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="VfSettingsPageBrush" Color="#1C1C1E" />
          <SolidColorBrush x:Key="VfSettingsAccentBrush" Color="{DynamicResource SystemAccentColorLight2}" />
          <SolidColorBrush x:Key="VfSettingsCardBrush" Color="#0FFFFFFF" />
          <SolidColorBrush x:Key="VfSettingsCardBorderBrush" Color="#1AFFFFFF" />
          <SolidColorBrush x:Key="VfSettingsDividerBrush" Color="#14FFFFFF" />
          <SolidColorBrush x:Key="VfSettingsSubtleBrush" Color="#A8A8B0" />
          <SolidColorBrush x:Key="VfSettingsIconChipBrush" Color="#264CC2FF" />
          <SolidColorBrush x:Key="VfSettingsWarningBackgroundBrush" Color="#433519" />
          <SolidColorBrush x:Key="VfSettingsWarningBrush" Color="#FCE100" />
          <SolidColorBrush x:Key="VfSettingsFooterBrush" Color="#202022" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Window.Styles>
    <!-- A style rather than a local value, so AttachBackdrop can clear its own override and fall back to this. -->
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource VfSettingsPageBrush}" />
    </Style>

    <!-- Fluent buttons left-align their content; with a MinWidth (Cancel/Save) that leaves the label off-centre. -->
    <Style Selector="Button">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- Section heading: accent icon + title, sitting just above its card. -->
    <Style Selector="StackPanel.heading">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="8" />
      <Setter Property="Margin" Value="4,0,0,8" />
    </Style>
    <Style Selector="StackPanel.heading > c|StrokeIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="StrokeThickness" Value="1.9" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource VfSettingsAccentBrush}" />
    </Style>
    <Style Selector="StackPanel.heading > TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource VfSettingsCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource VfSettingsCardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!-- One setting inside a card. -->
    <Style Selector="Border.item">
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="MinHeight" Value="56" />
    </Style>
    <Style Selector="Border.divider">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource VfSettingsDividerBrush}" />
    </Style>

    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource VfSettingsSubtleBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontFeatures" Value="+tnum" />
      <Setter Property="Foreground" Value="{DynamicResource VfSettingsAccentBrush}" />
    </Style>

    <!-- Rounded tile behind a row's leading icon (indexed folders). -->
    <Style Selector="Border.chip">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{DynamicResource VfSettingsIconChipBrush}" />
    </Style>
    <Style Selector="Border.chip > c|StrokeIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="StrokeThickness" Value="1.8" />
      <Setter Property="Foreground" Value="{DynamicResource VfSettingsAccentBrush}" />
    </Style>

    <!-- Switches without the On/Off caption: the row's title says what they do. -->
    <Style Selector="ToggleSwitch">
      <Setter Property="OnContent" Value="{x:Null}" />
      <Setter Property="OffContent" Value="{x:Null}" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <!-- The template keeps a 12px column for the caption even when empty; pull the switch to the card's edge. -->
      <Setter Property="Margin" Value="0,0,-12,0" />
    </Style>
    <Style Selector="Grid.item-row > Slider">
      <Setter Property="Margin" Value="0,-4,0,-8" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Padding="24,14" BorderThickness="0,1,0,0"
            Background="{DynamicResource VfSettingsFooterBrush}"
            BorderBrush="{DynamicResource VfSettingsCardBorderBrush}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button Content="{x:Static l:Strings.Cancel}" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="96" />
          <Button Content="{x:Static l:Strings.Save}" Command="{Binding SaveCommand}" IsDefault="True" MinWidth="96" Classes="accent" />
        </StackPanel>
        <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                   VerticalAlignment="Center" Margin="0,0,12,0" />
      </DockPanel>
    </Border>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,20,24,24">

        <!-- Hotkey -->
        <StackPanel Classes="heading">
          <c:StrokeIcon Data="{StaticResource VfIconKeyboard}" />
          <TextBlock Text="{x:Static l:Strings.SettingsGlobalShortcut}" />
        </StackPanel>
        <Border Classes="card">
          <Border Classes="item">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <c:HotkeyBox Text="{Binding Hotkey}" PlaceholderText="{x:Static l:Strings.SettingsHotkeyPlaceholder}"
                             AutomationProperties.Name="{x:Static l:Strings.SettingsGlobalShortcut}" />
                <Button Grid.Column="1" Content="{x:Static l:Strings.SettingsReset}" Command="{Binding ResetHotkeyCommand}"
                        VerticalAlignment="Stretch" />
              </Grid>
              <TextBlock Classes="hint" Text="{Binding DefaultHotkeyText}" />
              <TextBlock Text="{Binding HotkeyMessage}" IsVisible="{Binding HotkeyMessage, Converter={x:Static ObjectConverters.IsNotNull}}"
                         Foreground="{DynamicResource VfSettingsWarningBrush}" TextWrapping="Wrap" FontSize="12" />
            </StackPanel>
          </Border>
        </Border>

        <!-- Folders -->
        <StackPanel Classes="heading" Margin="4,28,0,8">
          <c:StrokeIcon Data="{StaticResource VfIconFolder}" />
          <TextBlock Text="{x:Static l:Strings.SettingsIndexedFolders}" />
        </StackPanel>
        <Border Classes="card">
          <StackPanel>
            <!-- Empty state: the home folder is what gets indexed. -->
            <Border Classes="item" IsVisible="{Binding HasNoRoots}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border Classes="chip">
                  <c:StrokeIcon Data="{StaticResource VfIconFolder}" />
                </Border>
                <TextBlock Grid.Column="1" Classes="title" Text="{Binding RootsEmptyText}" VerticalAlignment="Center"
                           TextWrapping="NoWrap" TextTrimming="PathSegmentEllipsis" />
              </Grid>
            </Border>
            <ItemsControl ItemsSource="{Binding Roots}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <StackPanel>
                    <Border Classes="item">
                      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Classes="chip">
                          <c:StrokeIcon Data="{StaticResource VfIconFolder}" />
                        </Border>
                        <TextBlock Grid.Column="1" Classes="title" Text="{Binding}" VerticalAlignment="Center"
                                   TextWrapping="NoWrap" TextTrimming="PathSegmentEllipsis" />
                        <Button Grid.Column="2" Content="{x:Static l:Strings.SettingsRemove}" VerticalAlignment="Center"
                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveRootCommand}"
                                CommandParameter="{Binding}" />
                      </Grid>
                    </Border>
                    <Border Classes="divider" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Classes="divider" IsVisible="{Binding HasNoRoots}" />
            <Border Classes="item">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <TextBlock Classes="hint" Text="{Binding RootsHint}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Command="{Binding AddRootCommand}" VerticalAlignment="Top">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:StrokeIcon Data="{StaticResource VfIconPlus}" Width="14" Height="14" StrokeThickness="2"
                                  VerticalAlignment="Center" />
                    <TextBlock Text="{x:Static l:Strings.SettingsAddFolder}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <!-- Resources -->
        <StackPanel Classes="heading" Margin="4,28,0,8">
          <c:StrokeIcon Data="{StaticResource VfIconCpu}" />
          <TextBlock Text="{x:Static l:Strings.SettingsIdleSection}" />
        </StackPanel>
        <Border Classes="card">
          <StackPanel>
            <Border Classes="item">
              <Grid Classes="item-row" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
                <TextBlock Classes="title" Text="{x:Static l:Strings.SettingsMaxCpu}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="value" Text="{Binding MaxCpuText}" VerticalAlignment="Center" />
                <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="5" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                        Value="{Binding MaxCpuPercent}" AutomationProperties.Name="{x:Static l:Strings.SettingsMaxCpuA11y}" />
              </Grid>
            </Border>
            <Border Classes="divider" />
            <Border Classes="item">
              <Grid Classes="item-row" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
                <TextBlock Classes="title" Text="{x:Static l:Strings.SettingsMaxDisk}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="value" Text="{Binding MaxDiskText}" VerticalAlignment="Center" />
                <Slider Grid.Row="1" Grid.ColumnSpan="2" Minimum="5" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                        Value="{Binding MaxDiskBusyPercent}" AutomationProperties.Name="{x:Static l:Strings.SettingsMaxDiskA11y}" />
              </Grid>
            </Border>
            <Border Classes="divider" />
            <Border Classes="item">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <TextBlock Classes="title" Text="{x:Static l:Strings.SettingsPauseOnBattery}" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding PauseOnBattery}"
                              AutomationProperties.Name="{x:Static l:Strings.SettingsPauseOnBattery}" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <!-- Model -->
        <StackPanel Classes="heading" Margin="4,28,0,8">
          <c:StrokeIcon Data="{StaticResource VfIconLogo}" />
          <TextBlock Text="{x:Static l:Strings.SettingsModelSection}" />
        </StackPanel>
        <Border Classes="card">
          <StackPanel>
            <Border Classes="item">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="title" Text="{x:Static l:Strings.SettingsDimensions}" />
                    <TextBlock Classes="hint" Text="{x:Static l:Strings.SettingsDimensionsHint}" />
                  </StackPanel>
                  <ComboBox Grid.Column="1" ItemsSource="{Binding DimensionOptions}" SelectedItem="{Binding SelectedDimensions}"
                            MinWidth="120" VerticalAlignment="Center"
                            AutomationProperties.Name="{x:Static l:Strings.SettingsDimensionsA11y}" />
                </Grid>
                <Border Background="{DynamicResource VfSettingsWarningBackgroundBrush}" CornerRadius="6" Padding="10,8"
                        IsVisible="{Binding ShowReindexWarning}">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <c:StrokeIcon Data="{StaticResource VfIconWarning}" Width="16" Height="16" StrokeThickness="1.8"
                                  Foreground="{DynamicResource VfSettingsWarningBrush}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{x:Static l:Strings.SettingsReindexWarning}" TextWrapping="Wrap" FontSize="12"
                               VerticalAlignment="Center" />
                  </Grid>
                </Border>
              </StackPanel>
            </Border>
            <Border Classes="divider" />
            <Border Classes="item">
              <StackPanel Spacing="8">
                <TextBlock Classes="title" Text="{x:Static l:Strings.SettingsModelFolder}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Text="{Binding ModelDirectory}" PlaceholderText="{x:Static l:Strings.SettingsModelFolderAutomatic}"
                           AutomationProperties.Name="{x:Static l:Strings.SettingsModelFolder}" />
                  <Button Grid.Column="1" Content="{x:Static l:Strings.SettingsBrowse}" Command="{Binding BrowseModelDirectoryCommand}"
                          VerticalAlignment="Stretch" />
                </Grid>
                <TextBlock Classes="hint" Text="{Binding ModelDetectionText}" />
              </StackPanel>
            </Border>
            <Border Classes="divider" />
            <Border Classes="item" MinHeight="0">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <c:StrokeIcon Data="{StaticResource VfIconLock}" Width="14" Height="14" StrokeThickness="1.8"
                              Foreground="{DynamicResource VfSettingsSubtleBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="hint" Text="{x:Static l:Strings.SettingsPrivacy}" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>

        <!-- General -->
        <StackPanel Classes="heading" Margin="4,28,0,8">
          <c:StrokeIcon Data="{StaticResource VfIconGear}" />
          <TextBlock Text="{x:Static l:Strings.SettingsGeneral}" />
        </StackPanel>
        <Border Classes="card">
          <StackPanel>
            <Border Classes="item">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                  <TextBlock Classes="title" Text="{x:Static l:Strings.SettingsLanguage}" />
                  <TextBlock Classes="hint" Text="{x:Static l:Strings.SettingsLanguageHint}" IsVisible="{Binding ShowLanguageRestartHint}" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}"
                          MinWidth="200" VerticalAlignment="Center" AutomationProperties.Name="{x:Static l:Strings.SettingsLanguage}" />
              </Grid>
            </Border>
            <Border Classes="divider" />
            <Border Classes="item">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <TextBlock Classes="title" Text="{x:Static l:Strings.SettingsStartAtLogin}" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding StartAtLogin}"
                              AutomationProperties.Name="{x:Static l:Strings.SettingsStartAtLogin}" />
              </Grid>
            </Border>
            <Border Classes="divider" />
            <Border Classes="item">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                  <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="title" Text="{x:Static l:Strings.SettingsAutoUpdate}" />
                    <TextBlock Classes="hint" Text="{Binding UpdateStatus}" />
                  </StackPanel>
                  <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutomaticUpdates}"
                                AutomationProperties.Name="{x:Static l:Strings.SettingsAutoUpdate}" />
                </Grid>
                <Button Content="{x:Static l:Strings.SettingsCheckForUpdates}" Command="{Binding CheckForUpdatesCommand}"
                        HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
            <Border Classes="divider" />
            <Border Classes="item">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <TextBlock Classes="hint" VerticalAlignment="Center" TextTrimming="PathSegmentEllipsis" TextWrapping="NoWrap">
                  <Run Text="{x:Static l:Strings.SettingsLogs}" /><Run Text=" " /><Run Text="{Binding LogDirectory}" />
                </TextBlock>
                <Button Grid.Column="1" Content="{x:Static l:Strings.SettingsOpenLogFolder}" Command="{Binding OpenLogFolderCommand}"
                        VerticalAlignment="Center" />
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
