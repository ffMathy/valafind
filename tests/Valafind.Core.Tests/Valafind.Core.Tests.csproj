<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Valafind.Core\Valafind.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- A tiny stand-in for the model that release builds embed in Valafind.Model (see BundledModelTests). -->
    <EmbeddedResource Include="Fixtures\BundledModel\**" LogicalName="ValafindModel/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>
</Project>
